#!/usr/bin/env bash
# ==============================================================================
# COMMAND CENTER // macOS Business Operating System CLI
# ==============================================================================

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
PID_FILE="$DIR/.command-center.pid"
PORT=8787
HOST="127.0.0.1"

get_pid() {
  if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE")
    if ps -p "$PID" > /dev/null 2>&1; then
      echo "$PID"
      return
    fi
  fi
  # Fallback to lsof on port
  PID=$(lsof -ti :$PORT 2>/dev/null | head -n 1)
  if [ -n "$PID" ]; then
    echo "$PID"
  fi
}

cmd_start() {
  PID=$(get_pid)
  if [ -n "$PID" ]; then
    echo -e "\033[33m[WARN]\033[0m Command Center is already running (PID: $PID) on http://$HOST:$PORT"
    return 0
  fi

  echo -e "\033[33m[BOOT]\033[0m Starting Command Center local feeder on http://$HOST:$PORT..."
  nohup python3 "$DIR/server.py" > "$DIR/command-center.log" 2>&1 &
  NEW_PID=$!
  echo $NEW_PID > "$PID_FILE"
  sleep 1

  if ps -p $NEW_PID > /dev/null 2>&1; then
    echo -e "\033[32m[ACTIVE]\033[0m Command Center running successfully (PID: $NEW_PID)"
    echo -e "         URL: \033[1;33mhttp://$HOST:$PORT\033[0m"
    echo -e "         Binding: Localhost only (Strict 127.0.0.1)"
  else
    echo -e "\033[31m[ERROR]\033[0m Failed to start server. Check logs: $DIR/command-center.log"
    exit 1
  fi
}

cmd_stop() {
  PID=$(get_pid)
  if [ -z "$PID" ]; then
    echo -e "\033[33m[INFO]\033[0m Command Center is not currently running."
    rm -f "$PID_FILE"
    return 0
  fi

  echo -e "\033[33m[SHUTDOWN]\033[0m Stopping Command Center feeder (PID: $PID)..."
  kill $PID 2>/dev/null
  sleep 1
  if ps -p $PID > /dev/null 2>&1; then
    kill -9 $PID 2>/dev/null
  fi
  rm -f "$PID_FILE"
  echo -e "\033[32m[STOPPED]\033[0m Command Center shut down cleanly."
}

cmd_restart() {
  cmd_stop
  sleep 1
  cmd_start
}

cmd_status() {
  PID=$(get_pid)
  echo "============================================================"
  echo " COMMAND CENTER // macOS Business Operating System"
  echo "============================================================"
  if [ -n "$PID" ]; then
    echo -e "Status:      \033[32mONLINE // ACTIVE\033[0m"
    echo -e "Process ID:  $PID"
    echo -e "Binding:     http://$HOST:$PORT (127.0.0.1 ONLY)"
    
    # Query state
    STATE_INFO=$(curl -s "http://$HOST:$PORT/api/state" 2>/dev/null)
    if [ -n "$STATE_INFO" ]; then
      COMMIT=$(echo "$STATE_INFO" | python3 -c "import sys, json; d=json.load(sys.stdin); print(d.get('services',{}).get('settings',{}).get('data',{}).get('updater',{}).get('commit','unknown'))")
      BRANCH=$(echo "$STATE_INFO" | python3 -c "import sys, json; d=json.load(sys.stdin); print(d.get('services',{}).get('settings',{}).get('data',{}).get('updater',{}).get('branch','main'))")
      SERVICES=$(echo "$STATE_INFO" | python3 -c "import sys, json; d=json.load(sys.stdin); print(len(d.get('services',{})))")
      echo -e "Git Commit:  $COMMIT (branch: $BRANCH)"
      echo -e "Services:    $SERVICES modular integrations mounted"
    fi
  else
    echo -e "Status:      \033[31mOFFLINE // STOPPED\033[0m"
    echo -e "Binding:     http://$HOST:$PORT"
    echo -e "Action:      Run './command-center start' to launch"
  fi
  echo "============================================================"
}

cmd_open() {
  PID=$(get_pid)
  if [ -z "$PID" ]; then
    echo -e "\033[33m[NOTICE]\033[0m Starting server first..."
    cmd_start
  fi
  echo -e "\033[33m[OPEN]\033[0m Launching Command Center in default macOS browser..."
  open "http://$HOST:$PORT"
}

cmd_test() {
  if [ -f "tests/test_full_suite.py" ]; then
    python3 tests/test_full_suite.py
  else
    echo -e "\033[33m[TEST]\033[0m Running Command Center automated verification suite..."
    python3 -c "
import urllib.request, json
try:
    with urllib.request.urlopen('http://$HOST:$PORT/api/state', timeout=5) as r:
        d = json.loads(r.read().decode('utf-8'))
        print('  [PASS] /api/state reachable')
        print(f'  [PASS] Mounted services: {list(d.get(\"services\", {}).keys())}')
    with urllib.request.urlopen('http://$HOST:$PORT/api/config', timeout=5) as r:
        c = json.loads(r.read().decode('utf-8'))
        print('  [PASS] /api/config reachable & masked')
    print('\033[32m  [SUCCESS] All verification probes passed.\033[0m')
except Exception as e:
    print(f'\033[31m  [FAIL] Error connecting to feeder: {e}\033[0m')
"
  fi
}

cmd_install_agent() {
  echo -e "\033[33m[macOS]\033[0m Registering Command Center LaunchAgent daemon..."
  python3 utils/macos.py install
}

cmd_uninstall_agent() {
  echo -e "\033[33m[macOS]\033[0m Deregistering Command Center LaunchAgent daemon..."
  python3 utils/macos.py uninstall
}

cmd_notify() {
  TITLE="${2:-Command Center}"
  MSG="${3:-macOS Notification Bridge Operational}"
  python3 utils/macos.py notify --title "$TITLE" --message "$MSG"
}

cmd_vault() {
  SUB="$2"
  shift 2 2>/dev/null || shift 1 2>/dev/null
  python3 utils/vault.py "$SUB" "$@"
}

cmd_briefing() {
  echo -e "\033[33m[DOSSIER]\033[0m Compiling Command Center Executive Business Dossier..."
  python3 utils/briefing.py
}

cmd_menubar() {
  python3 utils/menubar.py
}

cmd_llm() {
  PROMPT="${2:-Analyze current business velocity and market conditions.}"
  PROVIDER="${3:-ollama}"
  echo -e "\033[33m[AI WORKBENCH]\033[0m Dispatching query via $PROVIDER..."
  python3 -c "
import urllib.request, json
payload = json.dumps({'service': 'ai_workbench', 'action': 'run_prompt', 'payload': {'provider': '$PROVIDER', 'prompt': '$PROMPT', 'sandbox': True}}).encode('utf-8')
req = urllib.request.Request('http://127.0.0.1:8787/api/action', data=payload, headers={'Content-Type': 'application/json'})
with urllib.request.urlopen(req) as r:
    res = json.loads(r.read().decode('utf-8'))
    print(res.get('text', ''))
"
}

cmd_speak() {
  echo -e "\033[33m[AUDIO BRIEF]\033[0m Speaking Command Center executive business brief..."
  python3 -c "
from utils.briefing import speak_briefing
res = speak_briefing()
if res.get('success'):
    print('\033[32m[SPOKEN]\033[0m Briefing completed successfully.')
else:
    print('\033[31m[ERR]\033[0m', res.get('error', 'Speech synthesis failed'))
"
}

cmd_hardware() {
  echo "============================================================"
  echo " COMMAND CENTER // macOS Hardware Telemetry HUD"
  echo "============================================================"
  python3 -c "
import urllib.request, json
try:
    with urllib.request.urlopen('http://$HOST:$PORT/api/state', timeout=3) as r:
        d = json.loads(r.read().decode('utf-8'))
        hw = d.get('services', {}).get('intelligence', {}).get('data', {}).get('hardware', {})
        sys_info = hw.get('system', {})
        batt = hw.get('battery', {})
        disk = hw.get('disk', {})
        print(f'Apple Model:  {sys_info.get(\"model\", \"Macintosh\")}')
        print(f'Compute:      {sys_info.get(\"cpu_cores\", \"--\")} Cores // {sys_info.get(\"ram_gb\", \"--\")} GB RAM')
        print(f'Power/Batt:   {batt.get(\"status_label\", \"AC Connected\")} (Present: {batt.get(\"present\")})')
        print(f'SSD Storage:  {disk.get(\"free_gb\", 0)} GB Free of {disk.get(\"total_gb\", 0)} GB ({disk.get(\"used_pct\", 0)}% used)')
except Exception as e:
    print(f'Error querying hardware: {e}')
"
  echo "============================================================"
}

cmd_webhook_test() {
  SOURCE="${2:-stripe}"
  echo -e "\033[33m[WEBHOOK]\033[0m Transmitting test webhook payload to /api/webhooks/$SOURCE..."
  curl -s -X POST "http://$HOST:$PORT/api/webhooks/$SOURCE" \
    -H "Content-Type: application/json" \
    -d "{\"event\":\"payment_intent.succeeded\",\"customer\":\"cus_vip_998\",\"amount\":125000,\"currency\":\"usd\",\"status\":\"succeeded\"}" | python3 -m json.tool
}

cmd_scheduler() {
  ACTION="${2:-status}"
  JOB_ID="$3"
  if [ "$ACTION" == "trigger" ] && [ -n "$JOB_ID" ]; then
    echo -e "\033[33m[SCHEDULER]\033[0m Triggering scheduled task '$JOB_ID'..."
    curl -s -X POST "http://$HOST:$PORT/api/action" \
      -H "Content-Type: application/json" \
      -d "{\"service\":\"settings\",\"action\":\"trigger_scheduled_task\",\"payload\":{\"job_id\":\"$JOB_ID\"}}" | python3 -m json.tool
  else
    echo "============================================================"
    echo " COMMAND CENTER // Background Automation Tasks"
    echo "============================================================"
    curl -s "http://$HOST:$PORT/api/scheduler" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for j in data.get('jobs', []):
    print(f\"• [{j['status']}] {j['name']} ({j['interval_human']})\")
    print(f\"    ID: {j['id']} | Last Run: {j['last_run_str']} | Next: {j['next_run_str']}\")
    if j.get('last_result'):
        print(f\"    Result: {j['last_result'].get('summary', '')}\")
"
    echo "============================================================"
  fi
}

case "$1" in
  start)
    cmd_start
    ;;
  stop)
    cmd_stop
    ;;
  restart)
    cmd_restart
    ;;
  status)
    cmd_status
    ;;
  open)
    cmd_open
    ;;
  test)
    cmd_test
    ;;
  install-agent)
    cmd_install_agent
    ;;
  uninstall-agent)
    cmd_uninstall_agent
    ;;
  notify)
    cmd_notify "$@"
    ;;
  vault)
    cmd_vault "$@"
    ;;
  briefing)
    cmd_briefing
    ;;
  menubar)
    cmd_menubar
    ;;
  llm)
    cmd_llm "$@"
    ;;
  speak)
    cmd_speak
    ;;
  hardware)
    cmd_hardware
    ;;
  webhook-test)
    cmd_webhook_test "$@"
    ;;
  scheduler)
    cmd_scheduler "$@"
    ;;
  *)
    echo "Usage: ./command-center {start|stop|restart|status|open|test|install-agent|uninstall-agent|notify|vault|briefing|menubar|llm|speak|hardware|webhook-test|scheduler}"
    echo "       ./command-center briefing                        # Generate executive dossier"
    echo "       ./command-center speak                           # Speak audio executive brief aloud"
    echo "       ./command-center hardware                        # Display macOS hardware & power HUD"
    echo "       ./command-center webhook-test [source]           # Test inbound webhook ingestion & SSE"
    echo "       ./command-center scheduler [trigger <id>]        # Inspect or trigger cron automation jobs"
    echo "       ./command-center menubar                         # Run macOS status bar stream"
    echo "       ./command-center llm \"prompt\" [provider]         # Query AI Workbench"
    echo "       ./command-center notify \"Title\" \"Message\"        # Test macOS notification"
    echo "       ./command-center vault export --password <pass>  # Export encrypted vault"
    echo "       ./command-center vault import --vault <file>     # Restore encrypted vault"
    exit 1
    ;;
esac

