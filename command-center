cmd_kill() {
  PID="$2"
  SIG="${3:-TERM}"
  if [ -z "$PID" ]; then
    echo "Usage: ./command-center kill <pid> [TERM|KILL]"
    exit 1
  fi
  echo -e "\033[33m[SAFETY GUARD]\033[0m Terminate process $PID with SIG$SIG?"
  read -p "Type 'CONFIRM' to proceed: " CONF
  if [ "$CONF" != "CONFIRM" ]; then
    echo "Aborted."
    exit 1
  fi
  python3 -c "
from utils.process_watchdog import kill_process
res = kill_process($PID, signal_name='$SIG', confirmed=True)
if res.get('success'):
    print('\033[32m[TERMINATED]\033[0m', res.get('message'))
else:
    print('\033[31m[ERROR]\033[0m', res.get('message', res.get('error')))
"
}

